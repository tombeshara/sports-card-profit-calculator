                <div class="bg-indigo-50 p-5 rounded-xl shadow-inner space-y-4">

                    <!-- Fixed Fee Applied -->
                    <div class="flex justify-between items-center py-2 border-b bg-yellow-100 p-2 rounded-lg">
                        <span class="text-sm font-bold text-yellow-800">Fixed Fee Applied</span>
                        <span id="fixedFeeApplied" class="text-base font-extrabold text-yellow-800">$0.00</span>
                    </div>

                    <!-- Order Subtotal -->
                    <div class="flex justify-between items-center py-2 border-b">
                        <span class="text-sm font-medium text-gray-600">Total Item Price (Pre-Discount)</span>
                        <span id="subtotal" class="text-lg font-semibold text-gray-800">$0.00</span>
                    </div>

                    <!-- Discount Applied -->
                    <div class="flex justify-between items-center py-2 border-b">
                        <span class="text-sm font-medium text-gray-600">Bulk Discount Applied</span>
                        <span id="discountAmount" class="text-lg font-semibold text-red-600">-$0.00</span>
                    </div>
                    
                    <div class="flex justify-between items-center py-2 border-b">
                        <span class="text-sm font-medium text-gray-600">Discount Rate (%)</span>
                        <span id="discountRateDisplay" class="text-lg font-semibold text-red-600">0.00%</span>
                    </div>

                    <!-- Calculated Metrics -->
                    <div class="flex justify-between items-center py-2 border-b">
                        <span class="text-sm font-medium text-gray-600">Total Sale Amount (A)</span>
                        <span id="totalSale" class="text-xl font-bold text-indigo-800">$0.00</span>
                    </div>

                    <div class="flex justify-between items-center py-2 border-b">
                        <span class="text-sm font-medium text-gray-600">Total COGS (Item Cost)</span>
                        <span id="totalCogs" class="text-lg font-semibold text-red-600">-$0.00</span>
                    </div>
                    
                    <div class="flex justify-between items-center py-2 border-b">
                        <span class="text-sm font-medium text-gray-600">Advertising/Ad Cost (Calculated)</span>
                        <span id="marketingDollarDisplay" class="text-lg font-semibold text-red-600">-$0.00</span>
                    </div>

                    <div class="flex justify-between items-center py-2 border-b">
                        <span class="text-sm font-medium text-gray-600">Platform Fees (Variable + Fixed)</span>
                        <span id="feeAmount" class="text-lg font-semibold text-red-600">-$0.00</span>
                    </div>

                    <div class="flex justify-between items-center py-2 border-b">
                        <span class="text-sm font-medium text-gray-600">Allocated Overhead Cost</span>
                        <span id="overheadAllocation" class="text-lg font-semibold text-red-600">-$0.00</span>
                    </div>


                    <div class="flex justify-between items-center pt-4 mt-4 border-t border-indigo-200">
                        <span class="text-lg font-bold text-gray-800">NET PROFIT (Total Order)</span>
                        <span id="netProfit" class="text-3xl font-extrabold text-green-700">$0.00</span>
                    </div>
                    
                    <!-- Profit Per Card -->
                    <div class="flex justify-between items-center pt-4">
                        <span class="text-lg font-bold text-gray-800">NET PROFIT (Per Card)</span>
                        <span id="profitPerCard" class="text-2xl font-extrabold text-green-700">$0.00</span>
                    </div>

                    <p id="profitMessage" class="text-xs mt-2 text-center text-gray-600"></p>
                </div>
            </div>
        </div>
        
        <!-- NEW DISCLAIMER FOR PUBLIC USE -->
        <div class="mt-10 pt-4 border-t border-gray-200 text-center text-xs text-gray-500">
            Disclaimer: This Sports Card Profit Calculator provides estimates for modeling purposes only. The results are not financial advice. Users must verify all fees and costs with their respective platforms and tax advisors.
        </div>
        <!-- END DISCLAIMER -->
    </div>

    <script>
        // Function to ensure a value is a valid number, defaulting to 0 if invalid
        const safeParseFloat = (id) => {
            const element = document.getElementById(id);
            const value = +element.value;
            return isNaN(value) ? 0 : value;
        };

        const formatCurrency = (amount, color = false) => {
            const formatted = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }).format(Math.abs(amount));

            if (color) {
                // Determine color and sign
                if (amount > 0) return `<span class="text-green-700">${formatted}</span>`;
                if (amount < 0) return `<span class="text-red-600">-${formatted}</span>`;
            }
            return formatted;
        };
        
        // Function to update Fee inputs based on the selected preset (only changes percentage)
        function updateFeeInputs() {
            const preset = document.getElementById('feePreset').value;
            const feePercentInput = document.getElementById('feePercent');

            switch (preset) {
                case 'standard':
                    feePercentInput.value = 13.25;
                    break;
                case 'top_rated':
                    feePercentInput.value = 12.35; 
                    break;
                case 'default':
                    // User selected 'Custom/Manual Entry', focus the input field
                    feePercentInput.focus();
                    break;
            }
            // Recalculate profit every time the fee inputs are changed
            calculateProfit();
        }

        // Helper function to update the fixed fee labels dynamically based on the threshold input
        function updateFixedFeeLabels(thresholdValue) {
            const thresholdFormatted = formatCurrency(thresholdValue).replace('$', '\\$'); // Escape dollar sign for use in text

            document.getElementById('fixedFeeStandardLabel').textContent = 
                `Standard Fixed Per-Order Fee (less than ${thresholdFormatted})`;
            
            document.getElementById('fixedFeeHighValueLabel').textContent = 
                `High-Value Fixed Per-Order Fee (${thresholdFormatted}+)`;
        }


        function calculateProfit() {
            // 1. Get Inputs
            const quantity = safeParseFloat('quantity');
            const singleCardPrice = safeParseFloat('itemPrice');
            const singleCardCOGS = safeParseFloat('costOfGoods');

            // Get Discount Rates from Inputs
            const discount2Card = safeParseFloat('discount2Card') / 100;
            const discount3Card = safeParseFloat('discount3Card') / 100;
            const discount4Card = safeParseFloat('discount4Card') / 100;
            const discount5PlusCard = safeParseFloat('discount5PlusCard') / 100;

            // Per-Order Costs
            const shippingCharged = safeParseFloat('shippingCharged');
            const shippingCost = safeParseFloat('shippingCost');
            const packagingCost = safeParseFloat('packagingCost');
            const adRatePercent = safeParseFloat('marketingCost'); // Now read as a percentage

            // Fees & Overhead
            const feePercent = safeParseFloat('feePercent'); 
            const fixedFeeStandard = safeParseFloat('fixedFeeStandard'); 
            const fixedFeeHighValue = safeParseFloat('fixedFeeHighValue'); 
            const feeThreshold = safeParseFloat('feeThreshold'); 

            const annualFixedCost = safeParseFloat('annualFixedCost');
            const annualSalesEstimate = safeParseFloat('annualSalesEstimate');
            
            // Update labels immediately based on the current threshold
            updateFixedFeeLabels(feeThreshold);

            // Guardrail for invalid quantity
            if (quantity <= 0) {
                document.querySelectorAll('.text-lg, .text-xl, .text-2xl, .text-3xl').forEach(el => el.textContent = '$0.00');
                document.getElementById('subtotal').textContent = '$0.00';
                document.getElementById('discountAmount').textContent = '-$0.00';
                document.getElementById('discountRateDisplay').textContent = '0.00%';
                document.getElementById('fixedFeeApplied').textContent = '$0.00';
                document.getElementById('marketingDollarDisplay').textContent = '-$0.00';
                document.getElementById('overheadAllocation').textContent = '-$0.00'; // Reset overhead on invalid input
                document.getElementById('profitMessage').textContent = 'Please enter a quantity greater than zero.';
                return;
            }


            // 2. Apply Tiered Discount Logic
            const subtotal = singleCardPrice * quantity;
            let discountRate = 0; 

            if (quantity >= 5) {
                discountRate = discount5PlusCard;
            } else if (quantity === 4) {
                discountRate = discount4Card;
            } else if (quantity === 3) {
                discountRate = discount3Card;
            } else if (quantity === 2) {
                discountRate = discount2Card;
            } 

            const discountMultiplier = 1.0 - discountRate;
            const itemPriceAfterDiscount = subtotal * discountMultiplier;
            const discountAmount = subtotal * discountRate;

            // 3. Calculate Total Sale Amount (A) - Used for fee calculation
            const totalSale = itemPriceAfterDiscount + shippingCharged; // Total revenue received

            // 4. Determine Dynamic Fixed Fee
            let finalFixedFee = fixedFeeStandard;
            if (totalSale >= feeThreshold) {
                finalFixedFee = fixedFeeHighValue;
            }
            
            // 5. Calculate Marketing/Ad Dollar Cost
            const marketingDollarCost = totalSale * (adRatePercent / 100);


            // 6. Calculate Total Costs (C)
            const totalCOGS = singleCardCOGS * quantity; 

            // Calculate Overhead Allocation (based on Total Sale)
            let overheadAllocation = 0;
            if (annualSalesEstimate > 0) {
                const overheadRate = (annualFixedCost / annualSalesEstimate);
                overheadAllocation = totalSale * overheadRate;
            }

            // Platform Fees are based on Total Sale Amount (A) and the dynamically determined fixed fee
            const platformFeeAmount = (totalSale * (feePercent / 100)) + finalFixedFee;

            // All operational costs (COGS is total, others are per-order)
            // Note: marketingCost is now marketingDollarCost
            const totalOperationalCosts = totalCOGS + shippingCost + packagingCost + marketingDollarCost + overheadAllocation;


            // 7. Calculate Net Profit (Total Order)
            const netProfit = totalSale - platformFeeAmount - totalOperationalCosts;

            // 8. Calculate Net Profit Per Card
            const profitPerCard = netProfit / quantity;

            // 9. Update the UI
            document.getElementById('subtotal').textContent = formatCurrency(subtotal);
            document.getElementById('discountAmount').textContent = formatCurrency(-discountAmount); 
            document.getElementById('discountRateDisplay').textContent = `${(discountRate * 100).toFixed(2)}%`;
            document.getElementById('fixedFeeApplied').textContent = formatCurrency(finalFixedFee);

            document.getElementById('totalSale').textContent = formatCurrency(totalSale);
            document.getElementById('totalCogs').textContent = formatCurrency(-totalCOGS);
            document.getElementById('marketingDollarDisplay').textContent = formatCurrency(-marketingDollarCost);
            document.getElementById('feeAmount').textContent = formatCurrency(-platformFeeAmount);
            document.getElementById('overheadAllocation').textContent = formatCurrency(-overheadAllocation);
            
            // Total Profit (Order)
            const netProfitElement = document.getElementById('netProfit');
            netProfitElement.innerHTML = formatCurrency(netProfit, true);
            netProfitElement.className = netProfit >= 0
                ? 'text-3xl font-extrabold text-green-700'
                : 'text-3xl font-extrabold text-red-600';

            // Profit Per Card
            const profitPerCardElement = document.getElementById('profitPerCard');
            profitPerCardElement.innerHTML = formatCurrency(profitPerCard, true);
            profitPerCardElement.className = profitPerCard >= 0
                ? 'text-2xl font-extrabold text-green-700'
                : 'text-2xl font-extrabold text-red-600';


            // Update profit message
            const profitMessage = document.getElementById('profitMessage');
            if (netProfit > 0) {
                profitMessage.textContent = `Profitability achieved. You are making ${formatCurrency(netProfit)} on this ${quantity} card order.`;
            } else if (netProfit < 0) {
                profitMessage.textContent = `Warning: This order is currently losing ${formatCurrency(-netProfit)} after accounting for all costs.`;
            } else {
                profitMessage.textContent = 'This order has reached the break-even point.';
            }
        }

        // Run calculation on load with default values
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize fee percentage inputs based on the default selector value, and then run calculation
            updateFeeInputs(); 
        });
    </script>
</body>
</html>
