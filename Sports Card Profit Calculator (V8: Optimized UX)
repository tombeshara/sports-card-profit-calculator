                    <p class="text-xs text-gray-500 mt-1">
                        Enter the percentage (e.g., 5 for 5%) you are paying for Promoted Listings on the platform.
                    </p>
                </div>

                <hr class="my-6 border-indigo-200">

                <h2 class="text-xl font-bold text-indigo-600 mb-4 border-b pb-2">Inputs (Platform Fees & Overhead)</h2>
                
                <!-- Fee Preset Selector - UPDATED ORDER -->
                <div class="input-group">
                    <label for="feePreset" class="block text-sm font-medium text-gray-700">Platform Fee Preset (Ebay Sports Cards)</label>
                    <select id="feePreset" onchange="updateFeeInputs()"
                        class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 bg-white">
                        <option value="default">Custom/Manual Entry</option> <!-- MOVED TO TOP -->
                        <option value="standard" selected>Standard Seller (13.25%)</option>
                        <option value="top_rated">Top Rated Seller (12.35%)</option>
                    </select>
                    <p class="text-xs text-gray-500 mt-1">
                        Selecting a preset will overwrite the percentage fields below. Choose Custom to enter your own rate.
                    </p>
                </div>

                <!-- Input Group: Fee Percentage -->
                <div class="input-group">
                    <label for="feePercent" class="block text-sm font-medium text-gray-700">Final Value Fee Percentage (%)</label>
                    <input type="number" id="feePercent" value="13.25" min="0" max="100" step="0.01" oninput="calculateProfit()"
