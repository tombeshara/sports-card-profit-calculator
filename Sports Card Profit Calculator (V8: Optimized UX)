                    <label for="marketingCost" class="block text-sm font-medium text-gray-700">Marketing/Ad Rate (Promoted Listing %, applied to Total Sale)</label>
                    <input type="number" id="marketingCost" value="0.00" min="0" step="0.1" oninput="calculateProfit()"
