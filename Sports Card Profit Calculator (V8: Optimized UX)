                    <p class="text-xs text-gray-500 mt-1">Fee applied when Total Sale is **at or above** the threshold.</p>
                </div>
                
                <hr class="my-6 border-indigo-200">
                
                <!-- Input Group: Annual Fixed Costs -->
                <div class="input-group">
                    <label for="annualFixedCost" class="block text-sm font-medium text-gray-700">Total Annual Fixed Costs (e.g., Store Subscription, Overhead)</label>
                    <input type="number" id="annualFixedCost" value="720.00" min="0" step="0.01" oninput="calculateProfit()"
