                <!-- Input Group: High-Value Fixed Fee -->
                <div class="input-group">
                    <label for="fixedFeeHighValue" id="fixedFeeHighValueLabel" class="block text-sm font-medium text-gray-700">High-Value Fixed Per-Order Fee ($10.00+)</label>
                    <input type="number" id="fixedFeeHighValue" value="0.40" min="0" step="0.01" oninput="calculateProfit()"
