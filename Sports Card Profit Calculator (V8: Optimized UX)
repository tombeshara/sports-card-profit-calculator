                </div>
                
                <!-- Input Group: Standard Fixed Fee -->
                <div class="input-group">
                    <label for="fixedFeeStandard" id="fixedFeeStandardLabel" class="block text-sm font-medium text-gray-700">Standard Fixed Per-Order Fee (less than $10.00)</label>
                    <input type="number" id="fixedFeeStandard" value="0.30" min="0" step="0.01" oninput="calculateProfit()"
                        class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 transition duration-150">
                    <p class="text-xs text-gray-500 mt-1">Fee applied when Total Sale is **below** the threshold.</p>
